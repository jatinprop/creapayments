{
  "version": 2,
  "name": "crea-payment-suite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/head/status", "destination": "/api/head-status" },
    { "source": "/api/head/update", "destination": "/api/head" },
    { "source": "/api/head/delete", "destination": "/api/head-delete" },
    { "source": "/api/member/status", "destination": "/api/members" },
    { "source": "/api/member/activate-manual", "destination": "/api/members" },
    { "source": "/api/gst/(.*)", "destination": "/api/gst?gstin=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/|assets/|.*\\.(?:jpg|jpeg|png|gif|svg|ico|pdf|ttf|woff|woff2)).*)", "destination": "/index.html" }
  ]
}
