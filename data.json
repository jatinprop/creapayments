  "heads": [
    {
      "id": "head-mem",
      "code": "MEM",
      "title": "Annual CREA(I) Membership 2026-2027",
      "type": "membership",
      "eventDate": "2026-04-01",
      "eventTime": "Full Year Access",
      "venue": "CREA(I) Headquarters & All Chapters",
      "activeUntil": "2027-03-31T23:59:59",
      "status": "active",
      "prices": {
        "associate_member": 5000,
        "member": 10000,
        "board_member": 8000,
        "non_member": null
      },
      "writeup": "The Confederation of Real Estate Associates (India) — CREA(I) is the premier self-regulatory association of professional real estate brokers, property managers, and valuation experts in South India. \n\nYour annual membership subscription for FY 2026-2027 entitles your firm to comprehensive professional standing, legal assistance on brokerage covenant disputes, and direct integration into the CREA Multi-Listing Exchange (MLE). Associate Members affiliated with active primary member firms enjoy discounted annual fees.\n\nKey Member Privileges:\n1. Official CREA(I) Certified Realtor Certificate and verified digital credentials for client trust.\n2. Direct access to our monthly Legal & Notary clinic for RERA complaints, draft scrutiny, and deposit escrow guidance.\n3. Preferential registration rates on all accredited broker mastery certifications and quarterly state symposia.\n4. Comprehensive arbitration board access in the event of client or fellow broker commission evasion.\n5. Complimentary entry to the bi-annual Property Showcase networking breakfasts with tier-1 developers including Prestige, Sobha, and Brigade."
    },
    {
      "id": "head-trn1",
      "code": "TRN1",
      "title": "Masterclass: RERA Compliance, Title Verification & Escrows",
      "type": "training",
      "eventDate": "2026-10-28",
      "eventTime": "10:00 AM - 4:00 PM IST",
      "venue": "The Lalit Hotel, High Grounds, Bangalore",
      "activeUntil": "2026-10-28T09:00:00",
      "status": "active",
      "prices": {
        "associate_member": 1200,
        "member": 1200,
        "board_member": 0,
        "non_member": 2500
      },
      "writeup": "RERA litigation and title verification scrutiny have transformed real estate transactions into rigorous legal engagements. This full-day intensive masterclass is curated specifically for practicing real estate brokers, leasing executives, and independent agents seeking to eliminate liability and elevate deal closings.\n\nIncludes delegate entry pass QR, complimentary welcome gift kit QR, legal draft toolkit on pendrive, gourmet lunch, and accredited certification."
    },
    {
      "id": "head-trn2",
      "code": "TRN2",
      "title": "Executive Training: Digital Lead Generation & NRI Client Acquisition",
      "type": "training",
      "eventDate": "2026-11-18",
      "eventTime": "02:00 PM - 06:00 PM IST",
      "venue": "Virtual Live Interactive Studio (Zoom HD)",
      "activeUntil": "2026-11-18T13:30:00",
      "status": "active",
      "prices": {
        "associate_member": 800,
        "member": 800,
        "board_member": 0,
        "non_member": 1800
      },
      "writeup": "High-net-worth individuals and Non-Resident Indians (NRIs) represent over 38% of luxury real estate purchases and premium commercial leasing volume in metropolitan Bangalore. Reaching and qualifying these diaspora investors requires sophisticated digital acquisition funnels beyond conventional classifieds."
    },
    {
      "id": "head-evt1",
      "code": "EVT1",
      "title": "CREA(I) Annual Realty Conclave & Networking Gala 2026",
      "type": "event",
      "eventDate": "2026-12-15",
      "eventTime": "05:30 PM - 10:30 PM IST",
      "venue": "Grand Ballroom, The Leela Palace, Old Airport Road, Bangalore",
      "activeUntil": "2026-12-15T16:00:00",
      "status": "active",
      "prices": {
        "associate_member": 2800,
        "member": 2800,
        "board_member": 2000,
        "non_member": 5000
      },
      "writeup": "The flagship annual congregation of real estate leaders, developers, institutional funds, and accredited brokerages across India. Features keynote addresses by state urban development ministers, RERA chairpersons, and real estate investment trusts (REITs) directors.\n\nAll delegates receive an access pass QR code on their invoice for gate entry, plus a dedicated Gift Collection QR code for claiming the exclusive CREA delegate executive kit and memento at the registration kiosk."
    }
